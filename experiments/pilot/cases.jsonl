{"id": "n05", "state": {"stable_transcript": "", "current_partial": "まだ言葉にできていないんですけど。", "recent_context": []}, "reference_label": "no_bc", "label_status": "draft"}
{"id": "c05", "state": {"stable_transcript": "何があったか順に説明しますね。", "current_partial": "最初に、", "recent_context": []}, "reference_label": "continuer", "label_status": "draft"}
{"id": "u05", "state": {"stable_transcript": "資料の前半は手順で、後半は測定結果です。", "current_partial": "", "recent_context": []}, "reference_label": "understanding", "label_status": "draft"}
{"id": "e05", "state": {"stable_transcript": "落ち込んでいたときに友達が会いに来てくれて、本当に助かりました。", "current_partial": "", "recent_context": []}, "reference_label": "empathic", "label_status": "draft"}
{"id": "n06", "state": {"stable_transcript": "", "current_partial": "次の単語が出てこなくて、ええと。", "recent_context": []}, "reference_label": "no_bc", "label_status": "draft"}
